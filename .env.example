# Public URL of the panel (no trailing slash)
APP_URL=http://localhost:3000
APP_PORT=3000
# Generate with: bun apps/server/src/cli.ts key:generate
APP_KEY=
APP_ENV=production
APP_TIMEZONE=UTC

DATABASE_URL=postgres://ammonode:secret@127.0.0.1:5432/ammonode

# Directory for uploads, extensions, themes and backups of invoices
STORAGE_PATH=./storage

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Ammonode

# Set to true when the panel runs behind a reverse proxy (nginx, Caddy,
# Cloudflare) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
